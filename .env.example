# Dukaan Dost AI - Environment Configuration
# Flask Secret Key for session signing
FLASK_SECRET_KEY=replace_with_a_long_random_secret_for_production

# Gnani AI API Credentials (Prisma STT & Timbre TTS)
# You can provide a unified GNANI_API_KEY or individual STT and TTS keys:
GNANI_API_KEY=paste_your_gnani_api_key_here
GNANI_STT_API_KEY=paste_your_gnani_stt_api_key_here
GNANI_TTS_API_KEY=paste_your_gnani_tts_api_key_here

# Runtime & Server Configuration
FLASK_DEBUG=false
PORT=5000
DATABASE_PATH=instance/dukaan_dost.db

# Speech & Language Defaults
# Supported languages: te-IN (Telugu), en-IN (English), hi-IN (Hindi)
DEFAULT_LANGUAGE=te-IN
PRISMA_MODEL=prisma-v3.0
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Kaveri
